# รหัสลับที่ EA / bridge ต้องส่งมาใน header X-Auth-Token
INGEST_TOKEN=change-me

# ถ้าต่อ Vercel KV / Upstash Redis (แนะนำ) ตัวแปรสองตัวนี้ Vercel จะใส่ให้อัตโนมัติ
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ใส่ off เพื่อปิดข้อมูลตัวอย่างตอนยังไม่มีข้อมูลจริง
# DEMO_DATA=off

# prefix ของ key ที่เก็บ snapshot (default mt5:snapshot)
# แต่ละบัญชีเก็บแยกเป็น <prefix>:<login> อยู่แล้ว ไม่ต้องตั้งถ้าไม่ได้แยก dataset
# SNAPSHOT_KEY=mt5:snapshot
